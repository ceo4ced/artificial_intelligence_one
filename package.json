{
  "name": "ai-learning-platform-tests",
  "version": "1.0.6",
  "description": "AI Learning Platform - Testing Suite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore 'npm run test:run'"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@testing-library/dom": "^9.3.3",
    "@types/node": "^25.0.2",
    "@vitest/ui": "^1.0.4",
    "firebase": "^10.7.1",
    "happy-dom": "^12.10.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^1.0.4"
  }
}