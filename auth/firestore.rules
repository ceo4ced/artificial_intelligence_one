rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function getUserTier() {
      let role = getUserRole();
      return role == 'super_admin' ? 7 :
             role == 'system_admin' ? 6 :
             role == 'superintendent' || role == 'board' ? 5 :
             role == 'principal' || role == 'admin' ? 4 :
             role == 'teacher' ? 3 :
             role == 'student' ? 2 :
             role == 'guest' ? 1 : 0;
    }

    function hasMinimumTier(requiredTier) {
      return getUserTier() >= requiredTier;
    }

    function isTeacher() {
      return hasMinimumTier(3);
    }

    function isPrincipal() {
      return hasMinimumTier(4);
    }

    function isSuperintendent() {
      return hasMinimumTier(5);
    }

    function isSystemAdmin() {
      return hasMinimumTier(6);
    }

    function isSuperAdmin() {
      return hasMinimumTier(7);
    }

    function isStudent() {
      return getUserTier() >= 2;
    }

    function isStudentOrHigher() {
      return hasMinimumTier(2);
    }

    // Check if user is admin of an organization
    function isOrgAdmin(orgId) {
      let org = get(/databases/$(database)/documents/organizations/$(orgId)).data;
      return request.auth.uid in org.adminIds;
    }

    // Check if user has membership in organization
    function hasOrgMembership(orgId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(orgId + '_*'));
    }

    // Validate role assignment
    function isValidRoleAssignment(newRole, email) {
      return newRole == 'guest'
          || newRole == 'student'
          || (newRole == 'teacher' && isApprovedTeacherEmail(email));
    }

    function isApprovedTeacherEmail(email) {
      return email.matches('.*@.*\\.edu$')
          || email in [
            'teacher@school.edu',
            'instructor@school.edu',
            'admin@school.edu'
          ];
    }

    function roleNotChanged() {
      return request.resource.data.role == resource.data.role;
    }

    function hasRequiredUserFields() {
      return request.resource.data.keys().hasAll(['email', 'displayName', 'role', 'createdAt']);
    }

    // ============================================
    // USER PROFILES COLLECTION
    // ============================================

    match /users/{userId} {
      // Read: Own profile or teachers+ can read all
      allow read: if isCurrentUser(userId) || isTeacher();

      // Create: User creating own profile with valid data
      allow create: if isCurrentUser(userId)
        && hasRequiredUserFields()
        && isValidRoleAssignment(request.resource.data.role, request.resource.data.email);

      // Update: Own profile, can't change role (unless admin), can't change createdAt
      allow update: if isCurrentUser(userId)
        && (roleNotChanged() || isSystemAdmin())
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: Only super admin
      allow delete: if isSuperAdmin();

      // ============================================
      // QUIZ SCORES SUBCOLLECTION
      // ============================================

      match /quizScores/{quizId} {
        allow read: if isCurrentUser(userId) || isTeacher();

        allow create: if isCurrentUser(userId)
          && isStudentOrHigher()
          && request.resource.data.keys().hasAll(['quizId', 'score', 'totalQuestions', 'completedAt'])
          && request.resource.data.score >= 0;

        allow update: if isCurrentUser(userId)
          && isStudentOrHigher()
          && request.resource.data.quizId == resource.data.quizId;

        allow delete: if false;
      }

      // ============================================
      // USER MEMBERSHIPS SUBCOLLECTION
      // ============================================

      match /memberships/{membershipId} {
        allow read: if isCurrentUser(userId) || isTeacher();

        // Users can create pending memberships for themselves
        allow create: if isCurrentUser(userId)
          && request.resource.data.status == 'pending';

        // Only org admins or system admins can update membership status
        allow update: if isSystemAdmin()
          || isOrgAdmin(resource.data.organizationId);

        allow delete: if isSystemAdmin();
      }

      // ============================================
      // USER ENROLLMENTS SUBCOLLECTION
      // ============================================

      match /enrollments/{enrollmentId} {
        allow read: if isCurrentUser(userId) || isTeacher();

        // Students can create pending enrollments
        allow create: if isCurrentUser(userId);

        // Teachers can update enrollment status
        allow update: if isTeacher();

        allow delete: if isTeacher();
      }
    }

    // ============================================
    // ORGANIZATIONS COLLECTION
    // ============================================

    match /organizations/{orgId} {
      // Read: Authenticated users can read orgs they belong to, admins can read all
      allow read: if isAuthenticated() && (isPrincipal() || isOrgAdmin(orgId));

      // Create: Based on org type
      // State: Super admin only
      // District/County: Superintendent+
      // School: Principal+
      allow create: if isAuthenticated()
        && (
          (request.resource.data.type == 'state' && isSuperAdmin())
          || (request.resource.data.type in ['district', 'county'] && isSuperintendent())
          || (request.resource.data.type in ['school', 'city'] && isPrincipal())
        )
        && request.resource.data.keys().hasAll(['id', 'type', 'name', 'createdAt']);

      // Update: Org admins or higher tier admins
      allow update: if isOrgAdmin(orgId) || isSuperintendent()
        && request.resource.data.id == resource.data.id
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt;

      // Delete: System admin only
      allow delete: if isSystemAdmin();
    }

    // ============================================
    // CLASSROOMS COLLECTION
    // ============================================

    match /classrooms/{classroomId} {
      // Read: Teachers of the classroom, school admins, students in classroom
      allow read: if isAuthenticated()
        && (
          isTeacher()
          || resource.data.studentIds.hasAny([request.auth.uid])
        );

      // Create: Teachers only
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'name', 'schoolId', 'teacherId', 'createdAt']);

      // Update: Classroom teacher, co-teachers, or school admin
      allow update: if isAuthenticated()
        && (
          resource.data.teacherId == request.auth.uid
          || resource.data.coTeacherIds.hasAny([request.auth.uid])
          || isPrincipal()
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.schoolId == resource.data.schoolId;

      // Delete: Only the primary teacher or school admin
      allow delete: if resource.data.teacherId == request.auth.uid || isPrincipal();
    }

    // ============================================
    // SUBSCRIPTIONS COLLECTION
    // ============================================

    match /subscriptions/{subscriptionId} {
      // Read: Owner or system admins
      allow read: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          || isSystemAdmin()
          || (resource.data.organizationId != null && isOrgAdmin(resource.data.organizationId))
        );

      // Create: Authenticated users can create their own subscription
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['id', 'userId', 'tier', 'status', 'createdAt']);

      // Update: Owner (limited fields) or system admin (all fields)
      allow update: if isAuthenticated()
        && (
          (resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.id == resource.data.id)
          || isSystemAdmin()
        );

      // Delete: System admin only
      allow delete: if isSystemAdmin();
    }

    // ============================================
    // PAYMENTS COLLECTION
    // ============================================

    match /payments/{paymentId} {
      // Read: Owner or system admins
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isSystemAdmin());

      // Create: System only (via Cloud Functions) or system admin
      allow create: if isSystemAdmin();

      // Update: System admin only
      allow update: if isSystemAdmin();

      // Delete: Never
      allow delete: if false;
    }

    // ============================================
    // APPROVAL REQUESTS COLLECTION
    // ============================================

    match /approvalRequests/{requestId} {
      // Read: Request creator or school/org admins
      allow read: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          || isPrincipal()
        );

      // Create: Authenticated users
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Update: Only admins who can approve
      allow update: if isPrincipal()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.schoolId == resource.data.schoolId;

      // Delete: System admin only
      allow delete: if isSystemAdmin();
    }

    // ============================================
    // COUPONS COLLECTION
    // ============================================

    match /coupons/{couponCode} {
      // Read: Anyone can check if coupon exists
      allow read: if isAuthenticated();

      // Write: System admin only
      allow create, update, delete: if isSystemAdmin();
    }

    // ============================================
    // USAGE TRACKING COLLECTION
    // ============================================

    match /usage/{userId} {
      // Read: Own usage or system admin
      allow read: if isCurrentUser(userId) || isSystemAdmin();

      // Create/Update: Only through Cloud Functions or own usage
      allow create, update: if isCurrentUser(userId) || isSystemAdmin();

      // Delete: System admin only
      allow delete: if isSystemAdmin();
    }

    // ============================================
    // QUIZ DEFINITIONS COLLECTION (READ-ONLY)
    // ============================================

    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    // ============================================
    // CONTENT METADATA COLLECTION
    // ============================================

    match /contentMetadata/{contentId} {
      // Read: Based on content tier and user subscription
      allow read: if isAuthenticated();

      // Write: System admin only
      allow write: if isSystemAdmin();
    }

    // ============================================
    // SYSTEM LOGS COLLECTION (AUDIT TRAIL)
    // ============================================

    match /systemLogs/{logId} {
      allow read: if isSystemAdmin();
      allow write: if false; // Only via Cloud Functions
    }

    // ============================================
    // ANALYTICS COLLECTION
    // ============================================

    match /analytics/{docId} {
      // Read: Based on scope
      allow read: if isTeacher();

      // Write: System only
      allow write: if isSystemAdmin();

      // Aggregated analytics subcollections
      match /{subcollection}/{subDocId} {
        allow read: if isTeacher();
        allow write: if isSystemAdmin();
      }
    }

    // ============================================
    // CATCH-ALL - DENY BY DEFAULT
    // ============================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
